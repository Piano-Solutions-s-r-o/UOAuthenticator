{
  "name": "unlike-other-authenticator",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "workspaces": [
    "API",
    "Auth",
    "Admin",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @uoa/api dev",
    "dev:auth": "pnpm --filter @uoa/auth dev",
    "dev:admin": "pnpm --filter @uoa/admin dev",
    "billing:provision-stripe-catalog": "pnpm --filter @uoa/api billing:provision-stripe-catalog",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier -w .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}
